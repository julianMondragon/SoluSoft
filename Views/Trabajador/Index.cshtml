
@model List<TAS360.Models.Trabajador>
@{
    ViewBag.Title = "Trabajadores registrados";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}
<div class="container">

    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Trabajadores</h2>
        <p>
            Trabajadores registrados para la generación de DC-3
        </p>
        <a href="@Url.Action("Create")" class="btn btn-success btn-sm pull-right">
            + Nuevo Trabajador
        </a>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h4>Listado de trabajadores (@Model.Count)</h4>
        </div>

        <div class="panel-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>CURP</th>
                        <th>Puesto</th>
                        <th>Empresa</th>
                        <th>Ocupación</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.CURP</td>
                                <td>@item.Puesto</td>
                                <td>@(item.Empresa != null ? item.Empresa.Nombre : "N/A")</td>
                                <td>@(item.Ocupacion != null ? item.Ocupacion.Clave + " - " + item.Ocupacion.Nombre : "N/A")</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-primary btn-xs">Editar</a>

                                    @using (Html.BeginForm("DeleteConfirmed", "Trabajador", new { id = item.Id }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-danger btn-xs"
                                                onclick="return confirm('¿Seguro que deseas eliminar este trabajador?');">
                                            Eliminar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay trabajadores registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

