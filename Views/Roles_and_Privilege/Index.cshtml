    @*aqui acaba el div*@
    @*tabla Rol_Operacion Administrador *@
    <div class="col-md-3">
        <div class="panel panel-info">
            <div class="panel-heading clearfix">
                <div class="pull-left">
                    <b>Privilegios de <br /> Administrador (@Model.Rol_OperacionAdmin.Count)</b>
                </div>
                <div class="pull-right">
                    <button onclick="document.location.href='@Url.Content("~/Roles_and_Privilege/AddRol_Operacion/")'" class="btn btn-info" data-toggle="tooltip" title="Agregar Privilegios">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tags" viewBox="0 0 16 16">
                            <path d="M3 2v4.586l7 7L14.586 9l-7-7zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586z" />
                            <path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3M1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1z" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="panel-body" style="max-height: 65vh; overflow-y: auto;">
                <table id="ticketsTable" class="table table-success table-striped">
                    <thead>
                        <tr>
                            @*<th scope="col">Id</th>
                                @*<th colspan="2">Rol</th>*@
                            <th scope="col">Operacion</th>
                            <th scope="col">Accion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var RO in Model.Rol_OperacionAdmin)

                            {
                                int i = (int)RO.id_Roll;
                                int e = (int)RO.id_Operacion;
                                if (Model.Operacions.Find(x => x.id == e).nombre != null)
                                {
                                    <tr>
                                        @*<td>@RO.id</td>*@
                                        <td colspan="2"> @Model.Operacions.Find(x => x.id == e).nombre </td>
                                        <td colspan="2">
                                            @using (Html.BeginForm("DeleteRol_Operacion", "Roles_and_Privilege", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("id", RO.id)
                                                <button type="submit" class="btn btn-danger" data-toggle="tooltip" title="Eliminar Rol">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 448 512">
                                                        <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z" />
                                                    </svg>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
