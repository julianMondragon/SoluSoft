@model TAS360.Models.ViewModel.RolesPrivilegesViewModel
@{
    ViewBag.Title = "Roles & Privilegos";
    string exception = ViewBag.ExceptionMessage;
    string Info = ViewBag.InfoMessage;
    List<SelectListItem> Usuarios = (List<SelectListItem>)ViewBag.Usuarios;
    List<SelectListItem> Modulos = (List<SelectListItem>)ViewBag.Modulos;
}

<div class="jumbotron">
    <h1>Roles & Privilegios</h1>
    <p class="lead">Tod@s las Operaciones, Modulos, Usuarios, Roles & Privilegios del sistema </p>
    <p class="lead">
        @Html.Partial("_Alert")
    </p>
    @if (exception != null)
    {
        <div class="alert alert-danger" role="alert">
            @exception
        </div>
    }
    @if (Info != null)
    {
        <div class="alert alert-info" role="alert">
            @Info
        </div>
    }

    @*<div class="row">
            <div class="col-md-8"></div>
            <div class="col-md-4">
                <div class="d-flex justify-content-end">
                    <input type="text" id="searchInput" placeholder="Busqueda global" title="Busca cualquier concidencia del cuadro de busqueda con los tickets actuales">
                    <button onclick="filterTable()" class="btn btn-primary" title="Busca cualquier concidencia del cuadro de busqueda con los tickets actuales">Buscar</button>
                </div>
            </div>
        </div>*@
</div>
<!--Tablas -->
<div class="row">
    <div class="row">
        @*tabla Operaciones *@
        <div class="col-md-5">
            <div class="panel panel-default">
                <div class="panel-heading d-flex justify-content-between align-items-center">
                    <div>
                        <b>Operación</b>
                    </div>
                    <div>
                        <input type="text" style="width: 310px" id="searchPuntos" placeholder="Buscar Operacion">
                        <button onclick="filterTable('searchPuntos','OperationTable')"
                                class="btn btn-primary" type="button">
                            Buscar
                        </button>
                        <button onclick="document.location.href='@Url.Content("~/Roles_and_Privilege/AddOperation/")'"
                                class="btn btn-success" type="button" data-toggle="tooltip" title="Agregar Operación">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="16" fill="currentColor"
                                 class="bi bi-hammer" viewBox="0 0 16 16">
                                <path d="M9.972 2.508a.5.5 0 0 0-.16-.556l-.178-.129a5 5 0 0 0-2.076-.783C6.215.862 4.504 1.229 2.84 3.133H1.786a.5.5 0 0 0-.354.147L.146 4.567a.5.5 0 0 0 0 .706l2.571 2.579a.5.5 0 0 0 .708 0l1.286-1.29a.5.5 0 0 0 .146-.353V5.57l8.387 8.873A.5.5 0 0 0 14 14.5l1.5-1.5a.5.5 0 0 0 .017-.689l-9.129-8.63c.747-.456 1.772-.839 3.112-.839a.5.5 0 0 0 .472-.334" />
                            </svg>
                        </button>
                    </div>
                    <div class="input-group input-group-sm" style="width: 450px;">

                    </div>
                </div>
                <div class="panel-body" style="max-height: 50vh; overflow-y: auto;">
                    <table id="OperationTable" class="table table-success table-striped" style="width: 100%;">
                        <thead>
                            <tr>
                                <th style="width: 5%;">#</th>
                                <th style="width: 20%;">Nombre</th>
                                <th style="width: 20%;">Modulo</th>
                                <th style="width: 35%;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var operacion in Model.Operacions)

                                {
                                    if (operacion.nombre != null)
                                    {
                                        <tr>
                                            <td colspan="1"> @operacion.id</td>
                                            <td colspan="1"> @operacion.nombre</td>
                                            <td colspan="1"> @Modulos.FirstOrDefault(x => x.Value == operacion.id_Modulo.ToString()).Text</td>
                                            <td colspan="1">
                                                @using (Html.BeginForm("DeleteOperacion", "Roles_and_Privilege", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    <button onclick="document.location.href = '@Url.Action("EditOperation", "Roles_and_Privilege", new { id = operacion.id })'" type="button" class="btn btn-primary" data-toggle="tooltip" title="Editar Operación">
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><path d="M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z" /></svg>
                                                    </button>
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("id", operacion.id)
                                                    <button type="submit" class="btn btn-danger" data-toggle="tooltip" title="Eliminar Modulo">
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 448 512"><path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        @*tabla Modulos *@
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading clearfix">
                    <div class="pull-left">
                        <b>Modulo</b>
                    </div>
                    <div class="pull-right">
                        <button onclick="document.location.href='@Url.Content("~/Roles_and_Privilege/AddModule/")'" class="btn btn-success" data-toggle="tooltip" title="Agregar Modulo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-file-earmark-plus" viewBox="0 0 16 16">
                                <path d="M8 6.5a.5.5 0 0 1 .5.5v1.5H10a.5.5 0 0 1 0 1H8.5V11a.5.5 0 0 1-1 0V9.5H6a.5.5 0 0 1 0-1h1.5V7a.5.5 0 0 1 .5-.5" />
                                <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="panel-body" style="max-height: 50vh; overflow-y: auto;">
                    <table id="ticketsTable" class="table table-success table-striped">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th colspan="1">Nombre</th>
                                <th style="2">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var module in Model.Modules)

                                {
                                    if (module.nombre != null)
                                    {
                                        <tr>
                                            <td colspan="1">@module.id</td>
                                            <td colspan="2"> @module.nombre</td>
                                            <td colspan="1">
                                                @using (Html.BeginForm("DeleteModulos", "Roles_and_Privilege", FormMethod.Post))
                                                {
                                                    <button onclick="document.location.href = '@Url.Action("EditModulos", "Roles_and_Privilege", new { id = module.id })'" type="button" class="btn btn-primary" data-toggle="tooltip" title="Editar Modulos">
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 512 512"><path d="M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.7 15.7-7.4 21.9-13.5L437.7 172.3 339.7 74.3 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z" /></svg>
                                                    </button>
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("id", module.id)
                                                    <button type="submit" class="btn btn-danger" data-toggle="tooltip" title="Eliminar Modulo">
                                                        <svg xmlns="http://www.w3.org/2000/svg" height="1em" viewBox="0 0 448 512">
                                                            <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z" />
                                                        </svg>
                                                    </button>
                                                }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
