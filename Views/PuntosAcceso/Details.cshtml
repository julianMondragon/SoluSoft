@using TAS360.Helpers 
@model TAS360.Models.ViewModel.HikvisionPuntosAccesoViewModel
@{
    ViewBag.Title = "Detalles punto de acceso";

    var apiServer = Model.apiServer ?? string.Empty;
    var hostOnly = apiServer;
    var portValue = string.Empty;
    var isHttps = false;
    Uri parsedUri;

    if (!string.IsNullOrWhiteSpace(apiServer) && Uri.TryCreate(apiServer, UriKind.Absolute, out parsedUri))
    {
        hostOnly = parsedUri.Host;
        portValue = parsedUri.IsDefaultPort ? string.Empty : parsedUri.Port.ToString();
        isHttps = parsedUri.Scheme.Equals("https", StringComparison.OrdinalIgnoreCase);
    }
    else if (!string.IsNullOrWhiteSpace(apiServer) && Uri.TryCreate($"http://{apiServer}", UriKind.Absolute, out parsedUri))
    {
        hostOnly = parsedUri.Host;
        portValue = parsedUri.IsDefaultPort ? string.Empty : parsedUri.Port.ToString();
        isHttps = parsedUri.Scheme.Equals("https", StringComparison.OrdinalIgnoreCase);
    }
}

<style>
    .glyphicon.spin {
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(359deg);
        }
    }
</style>

<div class="jumbotron">
    <h1 class="display-4">@Model.nombre</h1>
    <p class="lead">Información del Punto de acceso registrado en el plantel.</p>
    <!-- LED de estado -->
    <span id="conn-led" class="label label-default">Comprobando...</span>
    <small id="conn-meta" class="text-muted"></small>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">Punto de Acceso</h3>
        

        <!-- Hidden con datos del dispositivo (no credenciales) -->
        @Html.Hidden("pa-host", hostOnly)
        @Html.Hidden("pa-port", portValue)
        @Html.Hidden("pa-https", isHttps)
    </div>
    <div class="panel-body">
        <table id="tblPuntosAcceso" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Plantel</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th>Api Server</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>@Model.id</td>
                    <td>@Model.nombre</td>
                    <td>@Model.NombrePlantel</td>
                    <td>@Model.ubicacion</td>
                    <td>@(Model.estado ? "Activo" : "Inactivo")</td>
                    <td>@Model.apiServer</td>
                    <td>
                        <a href="@Url.Action("Edit", "PuntosAcceso", new { id = Model.id })" class="btn btn-primary btn-sm">
                            <i class="glyphicon glyphicon-edit"></i> Editar
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">
            Eventos del día
            <span class="badge" id="events-count">0</span>
        </h3>
        <div class="pull-right" style="display:flex; gap:8px;">
            <div class="input-group input-group-sm" style="width: 220px;">
                <span class="input-group-addon"><span class="glyphicon glyphicon-search"></span></span>
                <input id="event-filter" type="text" class="form-control" placeholder="Filtrar eventos..." autocomplete="off" />
            </div>
            <button id="btn-refresh-events" type="button" class="btn btn-default btn-sm">
                <span class="glyphicon glyphicon-refresh"></span> Actualizar
            </button>
        </div>
    </div>
    <div class="panel-body">
        <div id="events-error" class="alert alert-danger hidden" role="alert"></div>
        <div class="table-responsive">
            <table id="tblEvents" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Serial Number</th>
                        <th>No Empleado</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Puerta</th>
                        <th>Hora</th>
                    </tr>
                </thead>
                <tbody id="events-body">
                    <tr>
                        <td colspan="6" class="text-center text-muted">Cargando eventos...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    function filterTable(inputId, tableId) {
        var input, filter, table, tr, td, i, j, txtValue, found;
        input = document.getElementById(inputId);
        filter = input.value.toUpperCase();
        table = document.getElementById(tableId);
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) {
            found = false;
            td = tr[i].getElementsByTagName("td");
            for (j = 0; j < td.length; j++) {
                txtValue = td[j].textContent || td[j].innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    found = true;
                    break;
                }
            }
            tr[i].style.display = found ? "" : "none";
        }
    }

</script>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script>
        (function () {
            var url = '@Url.Action("CheckStatus","PuntosAcceso", new { id = Model.id })';
            var $led = $("#conn-led");
            var $meta = $("#conn-meta");

            function setState(cls, text, meta) {
                $led.removeClass("label-default label-success label-danger label-warning")
                    .addClass(cls).text(text);
                if (meta) $meta.text(meta);
            }

            function ping() {
                var host = $("#pa-host").val();
                var port = $("#pa-port").val();
                var https = $("#pa-https").val() === "True" || $("#pa-https").val() === "true";

                $.getJSON(url, { host: host, port: port, https: https })
                    .done(function (r) {
                        if (r.online) {
                            setState("label-success", "En línea", "latencia: " + r.latencyMs + " ms • " + new Date().toLocaleTimeString());
                        } else {
                            var note = (r.statusCode ? ("HTTP " + r.statusCode) : (r.error || "Sin respuesta"));
                            setState("label-danger", "Sin comunicación", note + " • " + new Date().toLocaleTimeString());
                        }
                    })
                    .fail(function () {
                        setState("label-warning", "Intermitente", "Fallo de red • " + new Date().toLocaleTimeString());
                    });
            }

            ping();                 // primer chequeo
            setInterval(ping, 20000); // cada 20s
        })();

        (function () {
            function loadEventos() {
                var id = '@Model.id'; // id del punto actual
                $("#tbodyEventos").html('<tr><td colspan="6" class="text-center text-muted">Actualizando eventos...</td></tr>');
                $.get('@Url.Action("EventosHoyTable","PuntosAcceso")', { id: id })
                    .done(function (html) {
                        $("#tbodyEventos").html(html); // inyecta las filas <tr> del partial
                    })
                    .fail(function (xhr) {
                        $("#tbodyEventos").html('<tr><td colspan="6" class="text-danger">Error: ' + xhr.status + ' ' + xhr.statusText + '</td></tr>');
                    });
            }
            $("#btnActualizar").on("click", loadEventos);
            loadEventos(); // carga inicial
        })();
</script>
}


