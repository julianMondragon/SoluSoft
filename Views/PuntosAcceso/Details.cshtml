@model TAS360.Models.ViewModel.HikvisionPuntosAccesoViewModel
@{
    ViewBag.Title = "Detalles punto de acceso";
}

<div class="jumbotron">
    <h1 class="display-4">@Model.nombre</h1>
    <p class="lead">Información del Punto de acceso registrado en el plantel.</p>
    <!-- LED de estado -->
    <span id="conn-led" class="label label-default">Comprobando...</span>
    <small id="conn-meta" class="text-muted"></small>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">Punto de Acceso</h3>
        

        <!-- Hidden con datos del dispositivo (no credenciales) -->
        @Html.Hidden("pa-host", Model.apiServer)        <!-- p.ej. 192.168.1.50 -->
        @Html.Hidden("pa-port", string.Empty)
        @Html.Hidden("pa-https", "false")
    </div>
    <div class="panel-body">
        <table id="tblPuntosAcceso" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th>Api Server</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>

                <tr>
                    <td>@Model.id</td>
                    <td>@Model.nombre</td>
                    <td>@Model.ubicacion</td>
                    <td>@(Model.estado ? "Activo" : "Inactivo")</td>
                    <td>@Model.apiServer</td>
                    <td>
                        <a href="@Url.Action("Edit", "PuntosAcceso", new { id = Model.id })" class="btn btn-primary btn-sm">
                            <i class="glyphicon glyphicon-edit"></i> Editar
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">Eventos del día (tiempo real)</h3>
        <button type="button" id="btn-refresh-events" class="btn btn-link btn-sm pull-right" title="Actualizar">
            <span class="glyphicon glyphicon-refresh"></span> Actualizar
        </button>
    </div>
    <div class="panel-body">
        <div id="events-error" class="alert alert-danger" style="display:none;"></div>
        <div id="events-empty" class="alert alert-info" style="display:none;">
            No se encontraron eventos para el día de hoy.
        </div>
        <div class="table-responsive">
            <table id="tbl-events" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Nombre</th>
                        <th>Tarjeta</th>
                        <th>Evento</th>
                        <th>Punto de acceso</th>
                        <th>Hora</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <small id="events-meta" class="text-muted"></small>
    </div>
</div>
<script>
    function filterTable(inputId, tableId) {
        var input, filter, table, tr, td, i, j, txtValue, found;
        input = document.getElementById(inputId);
        filter = input.value.toUpperCase();
        table = document.getElementById(tableId);
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) {
            found = false;
            td = tr[i].getElementsByTagName("td");
            for (j = 0; j < td.length; j++) {
                txtValue = td[j].textContent || td[j].innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    found = true;
                    break;
                }
            }
            tr[i].style.display = found ? "" : "none";
        }
    }

</script>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            var url = '@Url.Action("CheckStatus","PuntosAcceso", new { id = Model.id })';
            var $led = $("#conn-led");
            var $meta = $("#conn-meta");

            function setState(cls, text, meta) {
                $led.removeClass("label-default label-success label-danger label-warning")
                    .addClass(cls).text(text);
                if (meta) $meta.text(meta);
            }

            function ping() {
                var host = $("#pa-host").val();
                var port = $("#pa-port").val();
                var https = $("#pa-https").val() === "True" || $("#pa-https").val() === "true";

                $.getJSON(url, { host: host, port: port, https: https })
                    .done(function (r) {
                        if (r.online) {
                            setState("label-success", "En línea", "latencia: " + r.latencyMs + " ms • " + new Date().toLocaleTimeString());
                        } else {
                            var note = (r.statusCode ? ("HTTP " + r.statusCode) : (r.error || "Sin respuesta"));
                            setState("label-danger", "Sin comunicación", note + " • " + new Date().toLocaleTimeString());
                        }
                    })
                    .fail(function () {
                        setState("label-warning", "Intermitente", "Fallo de red • " + new Date().toLocaleTimeString());
                    });
            }

            ping();                 // primer chequeo
            setInterval(ping, 20000); // cada 20s
        })();

        (function () {
            var eventsUrl = '@Url.Action("GetTodayEvents", "PuntosAcceso", new { id = Model.id })';
            var $tableBody = $('#tbl-events tbody');
            var $empty = $('#events-empty');
            var $error = $('#events-error');
            var $meta = $('#events-meta');
            var refreshHandle = null;
            var refreshMs = 15000;

            function formatDateTime(value) {
                if (!value) {
                    return '-';
                }

                var date = new Date(value);
                if (isNaN(date.getTime())) {
                    return value;
                }

                return date.toLocaleString();
            }

            function renderEvents(events) {
                $tableBody.empty();

                if (!events || !events.length) {
                    $empty.show();
                    return;
                }

                $empty.hide();

                $.each(events, function (index, evt) {
                    var description = evt.eventDescription || evt.eventType || '-';
                    if (evt.eventCode) {
                        description += ' (' + evt.eventCode + ')';
                    }

                    var $row = $('<tr>');
                    $row.append($('<td>').text(evt.employeeNo || '-'));
                    $row.append($('<td>').text(evt.personName || '-'));
                    $row.append($('<td>').text(evt.cardNumber || '-'));
                    $row.append($('<td>').text(description));
                    $row.append($('<td>').text(evt.doorName || '-'));
                    $row.append($('<td>').text(formatDateTime(evt.eventTime)));

                    $tableBody.append($row);
                });
            }

            function setLoadingState(message) {
                $meta.text(message || '');
            }

            function loadEvents(showLoading) {
                $error.hide();
                if (showLoading) {
                    setLoadingState('Actualizando eventos...');
                }

                $.getJSON(eventsUrl)
                    .done(function (response) {
                        if (response && response.success) {
                            renderEvents(response.data);
                            var updatedAt = response.timestamp ? formatDateTime(response.timestamp) : formatDateTime(new Date().toISOString());
                            setLoadingState('Última actualización: ' + updatedAt);
                        } else {
                            var message = (response && response.message) ? response.message : 'No fue posible obtener los eventos.';
                            $error.text(message).show();
                            setLoadingState('');
                        }
                    })
                    .fail(function () {
                        $error.text('No fue posible obtener los eventos.').show();
                        setLoadingState('');
                    });
            }

            $('#btn-refresh-events').on('click', function () {
                loadEvents(true);
            });

            loadEvents(true);
            refreshHandle = setInterval(function () { loadEvents(false); }, refreshMs);

            $(window).on('unload', function () {
                if (refreshHandle) {
                    clearInterval(refreshHandle);
                }
            });
        })();
    </script>
}


