
@model List<TAS360.Models.ViewModel.HikvisionPuntosAccesoViewModel>
@{
    ViewBag.Title = "Mis Puntos de acceso";
}

<div class="jumbotron">
    <h1 class="display-4">Puntos de acceso de @Model.FirstOrDefault().nombre</h1>
    <p class="lead">Lista de puntos de acceso registrados por plantel.</p>
    <p>
        <a href="@Url.Action("Create", "PuntosAcceso")" class="btn btn-success">Agregar Acceso »</a>
    </p>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Listado de Puntos de Acceso</h3>
    </div>

    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Plantel</th>
                    <th>Nombre</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th>API Server</th>
                    <th>Usuario</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.id</td>
                        @*<td>@item.idPlantel</td>*@
                        <td>@item.NombrePlantel</td>
                        <td>@item.nombre</td>
                        <td>@item.ubicacion</td>
                        <td>@(item.estado ? "Inactivo" : "Activo")</td>
                        <td>@item.apiServer</td>
                        <td>@item.usuario</td>
                        <td>
                            <a href="@Url.Action("Asistencias", "PuntosAcceso", new { id = item.id })" class="btn btn-default btn-sm">
                                <i class="glyphicon glyphicon-th-list"></i> Asistencias
                            </a>
                            <a href="@Url.Action("Edit", "PuntosAcceso", new { id = item.id })" class="btn btn-primary btn-sm">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "PuntosAcceso", new { id = item.id })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de eliminar este punto de acceso?');">
                                <i class="glyphicon glyphicon-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>