@model TAS360.Models.ViewModel.HikvisionPuntosAccesoViewModel

@{
    ViewBag.Title = "Nuevo Punto de Acceso";
}

<div class="jumbotron">
    <h1 class="display-4">Nuevo Punto de Acceso</h1>
    <p class="lead">Registra un nuevo punto de acceso para control y monitoreo.</p>
</div>

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-lock"></i> Formulario de Registro de Punto de Acceso
                </h3>
            </div>
            <div class="panel-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @using (Html.BeginForm("Create", "PuntosAcceso", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                      @Html.LabelFor(m => m.idPlantel, htmlAttributes: new { @class = "col-md-4 control-label" })
                       <div class="col-md-8">
                        @Html.DropDownListFor(
                            m => m.idPlantel,
                            (IEnumerable<SelectListItem>)ViewBag.idPlantel,
                            "Seleccione un Plantel",
                            new { @class = "form-control" }
                        )
                        @Html.ValidationMessageFor(m => m.idPlantel, "", new { @class = "text-danger" })
                       </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.nombre, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.nombre, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.ubicacion, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.ubicacion, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ubicacion, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.FechaHoraInstalacion, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.FechaHoraInstalacion, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.FechaHoraInstalacion, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.estado, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.estado, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Activo", Value = "true" },
                                new SelectListItem { Text = "Inactivo", Value = "false" }
                            }, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.estado, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.apiServer, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.apiServer, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.apiServer, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.usuario, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.usuario, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.usuario, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.password, htmlAttributes: new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.PasswordFor(m => m.password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.password, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-8">
                            <button type="submit" class="btn btn-success">Guardar</button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
