@model TAS360.Models.ViewModel.MainDashboardViewModel

@{
    ViewBag.Title = "Dashboard Principal";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}

<div class="jumbotron">
    <h1>📊 Dashboard Principal</h1>
    <p class="lead">Información básica del dispositivo conectado</p>

    @Html.Partial("_Alert")

</div>
<div class="container">
    <!-- Row 1 -->
    <div class="row">
        <!-- Sección Personas Registradas -->
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading clearfix">
                    <h4 class="pull-left" style="margin-top: 5px;">
                        🧍‍♂️ Personas Registradas @Model.NumPersonas /  500
                    </h4>
                    <a href="@Url.Action("CreateUser", "HikVision")" class="btn btn-success pull-right">
                        <i class="glyphicon glyphicon-plus"></i> Agregar
                    </a>
                </div>
                <div class="panel-body">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>No. Empleado</th>
                                <th>Tipo</th>
                                <th>Género</th>
                                <th># Finger</th>
                                <th># Face</th>
                                <th># Tag</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Personas.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center">Sin registros disponibles</td></tr>
                            }
                            else
                            {
                                foreach (var p in Model.Personas)
                                {
                        <tr>
                            <td>@p.name</td>
                            <td>@p.employeeNo</td>
                            <td>@p.userType</td>
                            <td>@(p.gender == "female" ? "Femenino" : "Masculino")</td>
                            <td>
                                @p.numOfFP
                                <a href="@Url.Action("EditUser", "HikVision", new { id = p.employeeNo })" class="btn btn-sm btn-success">
                                    <i class="glyphicon glyphicon-hand-up" title="Agregar huella facial"></i>
                                </a>
                            </td>
                            <td>
                                @p.numOfFace
                                <a href="@Url.Action("EditUser", "HikVision", new { id = p.employeeNo })" class="btn btn-sm btn-success">
                                    <i class="glyphicon glyphicon-camera" title="Agregar huella facial"></i>
                                </a>
                            </td>
                            <td>
                                @p.numOfCard
                                <a href="@Url.Action("EditUser", "HikVision", new { id = p.employeeNo })" class="btn btn-sm btn-success">
                                  <i class="glyphicon glyphicon-credit-card" title="Agregar tag"></i>
                                </a>
                            </td>
                            <td>
                                <a href="@Url.Action("EditUser", "HikVision", new { id = p.employeeNo })" class="btn btn-sm btn-primary">
                                    <i class="glyphicon glyphicon-edit" title="Editar usuario"></i>
                                </a>
                                @using (Html.BeginForm("DeleteUser", "HikVision", FormMethod.Post, new { @style = "display:inline;" }))
                                {
                                    @Html.Hidden("id", p.employeeNo)
                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('¿Estás seguro de eliminar este usuario?');">
                                        <i class="glyphicon glyphicon-trash" title="Eliminar usuario"></i>
                                    </button>
                                }

                            </td>
                        </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Información del Dispositivo -->
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    📑 <b>Información del Dispositivo</b>
                </div>
                <div class="panel-body">
                    <table class="table table-striped">
                        <tr><th>Modelo</th><td>@Model.DeviceInfo.Model</td></tr>
                        <tr><th>Nombre del Dispositivo</th><td>@Model.DeviceInfo.DeviceName</td></tr>
                        <tr><th>Número de Serie</th><td>@Model.DeviceInfo.SerialNumber</td></tr>
                        <tr><th>Firmware</th><td>@Model.DeviceInfo.FirmwareVersion</td></tr>
                    </table>
                </div>
            </div>
        </div>
        <!-- Sección Estado de la Red -->
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading">
                    📡 <b>Estado de la Red</b>
                </div>
                <div class="panel-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>IP</th>
                                <th>Estado</th>
                                <th>Tipo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var net in Model.NetworkInterfaces)
                            {
                                <tr>
                                    <td>@net.Name</td>
                                    <td>@net.IPAddress</td>
                                    <td>@net.LinkStatus</td>
                                    <td>@net.ConnectionType</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Estado General -->
        <div class="col-md-4">
            <div class="panel panel-default">
                <div class="panel-heading">
                    🌐 <b>Estado General</b>
                </div>
                <div class="panel-body">
                    <table class="table table-bordered">
                        <tr>
                            <th>Conexión API</th>
                            <td>
                                @if (ViewBag.IsActive)
                                {
                                    <span class="text-success"><b>Activa</b></span>
                                }
                                else
                                {
                                    <span class="text-danger"><b>Inactiva</b></span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Última actualización</th>
                            <td>@DateTime.Now.ToString("g")</td>
                        </tr>
                        <tr>
                            <th>Capacidad de almacenamiento</th>
                            <td>@Model.CapacidadEvento / @Model.MaxEventos eventos</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


