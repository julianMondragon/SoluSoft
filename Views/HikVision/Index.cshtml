@model TAS360.Models.ViewModel.HikVisionViewModel
@{
    ViewBag.Title = "HikVision API Communication";
    Layout = "~/Views/Shared/_Layout2.cshtml";
    string warning = ViewBag.Warning;
    string Open = ViewBag.Open;
    string Info = ViewBag.Info;
}

<div class="jumbotron">
    <h1>🔒 Control de acceso</h1>
    <p class="lead">
        Conexión ISAPI con el equipo <b>DS-K1T320MFWX-B</b>.
    </p>
    @if (warning != null)
    {
        <h3 style="color:sandybrown">@warning</h3>
    }
    @if (Info != null)
    {
        <h7 style="color:blue">@Info</h7>
    }
</div>
<style>
    .form-container {
        max-width: 500px;
        margin: 10px auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 8px;
        background: #f9f9f9;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }

    .form-title {
        text-align: center;
    }
</style>

<div class="container">
    <div class="form-container">
        @using (Html.BeginForm("Index", "HikVision", FormMethod.Post))
        {
            <div class="form-group">
                @Html.LabelFor(m => m.APIServer)
                @Html.TextBoxFor(m => m.APIServer, new { @class = "form-control", placeholder = "Ej: http://192.168.1.100" })
                @Html.ValidationMessageFor(m => m.APIServer, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario)
                @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", placeholder = "Ej: admin" })
                @Html.ValidationMessageFor(m => m.Usuario, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Ingrese su contraseña" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Peticion)
                @Html.TextBoxFor(m => m.Peticion, new { @class = "form-control", placeholder = "Ej: GET /ISAPI/AccessControl/AcsEvent" })
                @Html.ValidationMessageFor(m => m.Peticion, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Parametro)
                @Html.TextBoxFor(m => m.Parametro, new { @class = "form-control", placeholder = "Ej: { \"cardNo\": \"12345\" }" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Respuesta)
                @Html.TextAreaFor(m => m.Respuesta, new { @class = "form-control", rows = "3", placeholder = "Aquí aparecerá la respuesta..." })
            </div>

            <button type="submit" class="btn btn-primary btn-block">Enviar</button>
        }
    </div>
</div>

