<!-- jQuery para el plugin -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Collapser para colapsar líneas -->
<script src="https://cdn.jsdelivr.net/npm/jquery-collapser/jquery.collapser.min.js"></script>

@model TAS360.Models.ViewModel.HikVisionViewModel
@{
    ViewBag.Title = "HikVision API Communication";
    Layout = "~/Views/Shared/_Layout3.cshtml";
    string warning = ViewBag.Warning;
    string Open = ViewBag.Open;
    string Info = ViewBag.Info;
    string Resp = ViewBag.Respuesta;
}
<div class="jumbotron">
    @*<h1>🔒 Control de acceso</h1>*@
    <h1>🌐 Protocolo ISAPI</h1>
    <p class="lead">
        Conexión ISAPI con el equipo <b>DS-K1T320MFWX-B</b>.
    </p>
    @if (warning != null)
    {
        <h3 style="color:sandybrown">@warning</h3>
    }
    @if (Info != null)
    {
        <h7 style="color:blue">@Info</h7>
    }
</div>
<div class="container">
    <div class="form-container">
        @using (Html.BeginForm("Index", "HikVision", FormMethod.Post))
        {
            <div class="form-group text-right">
                <button type="submit" class="btn btn-lg btn-primary">Enviar</button>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label>API Server</label>
                    @Html.TextBoxFor(m => m.APIServer, new
                    {
                        @class = "form-control"@*, @readonly = "readonly"*@})
                </div>
                <div class="col-md-4">
                    <label>Usuario</label>
                    @Html.TextBoxFor(m => m.Usuario, new
                    {
                        @class = "form-control"@*, @readonly = "readonly"*@})
                </div>
                @Html.HiddenFor(model => model.Password)
                <div class="col-md-4">
                    <label>Password</label>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Peticion)
                @Html.TextBoxFor(m => m.Peticion, new { @class = "form-control", placeholder = "Ej: GET /ISAPI/AccessControl/AcsEvent" })
                @Html.ValidationMessageFor(m => m.Peticion, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Parametro)
                @Html.TextBoxFor(m => m.Parametro, new { @class = "form-control", placeholder = "Ej: { \"cardNo\": \"12345\" }" })
            </div>
        }

        @if (!string.IsNullOrEmpty(Model?.Respuesta))
        {
            <label>Respuesta</label>

            var tipo = ViewBag.ContentType;
            string clase = tipo == "application/json" ? "language-json" : (tipo == "application/xml" ? "language-xml" : "language-plaintext");
            <pre id="respuestaXml" class="line-numbers"><code class="@clase">@Model.Respuesta</code></pre>
        }
    </div>
</div>
<script>
    // Resalta código
    hljs.highlightAll();

    // Aplica colapser solo al PRE donde va el XML
    $('#respuestaXml').collapser({
        mode: 'lines',
        truncate: 8,      // Número de líneas visibles por defecto
        speed: 'medium',
        showText: '[+]',
        hideText: '[-]',
        atStart: 'show'
    });
</script>
<link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/default.min.css">
<script src="//cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>