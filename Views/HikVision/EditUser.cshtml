@model TAS360.Models.ViewModel.HikvisionUserViewModel
@{
    ViewBag.Title = "Editar Usuario en Dispositivo";
    Layout = "~/Views/Shared/_Layout3.cshtml";
    List<SelectListItem> Generos = (List<SelectListItem>)ViewBag.Generos;
    List<SelectListItem> TipoUsuario = (List<SelectListItem>)ViewBag.TipoUsuario;

}

<div class="jumbotron">
    <h1> Editar Usuario del Dispositivo</h1>

    @if (ViewBag.Warning != null)
    {
        <h4 style="color:sandybrown">@ViewBag.Warning</h4>
    }
    @if (ViewBag.Info != null)
    {
        <h5 style="color:blue">@ViewBag.Info</h5>
    }

</div>
<div class="container">
    <div class="form-container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.EmployeeNo)

            <div class="col-md-3">
                @Html.LabelFor(m => m.Name)
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Nombre completo" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(f => f.UserType)
                @Html.DropDownListFor(model => model.UserType, TipoUsuario, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.RoomNumber)
                @Html.TextBoxFor(m => m.RoomNumber, new { @class = "form-control", placeholder = "Ej. A101" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(f => f.gender)
                @Html.DropDownListFor(model => model.gender, Generos, new { @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.BeginTime)
                @Html.TextBoxFor(m => m.BeginTime, "{0:yyyy-MM-ddTHH:mm:ss}", new { type = "datetime-local", @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.EndTime)
                @Html.TextBoxFor(m => m.EndTime, "{0:yyyy-MM-ddTHH:mm:ss}", new { type = "datetime-local", @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.LabelFor(m => m.DoorRight)
                @Html.TextBoxFor(m => m.DoorRight, new { @class = "form-control", placeholder = "Ej. 1" })
            </div>
            <div class="col-md-12">
                <br />
                <button type="submit" class="btn btn-primary">
                    <i class="glyphicon glyphicon-save"></i> Guardar Cambios
                </button>
                @Html.ActionLink("Cancelar", "MainDashboard", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>



