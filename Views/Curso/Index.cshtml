
@model List<TAS360.Models.Curso>
@{
    ViewBag.Title = "Cursos registrados";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}
<div class="container">

    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Mis Cursos</h2>
        <p>
            Cursos registrados para la generación de DC-3
        </p>
        <a href="@Url.Action("Create")" class="btn btn-success btn-sm pull-right">
            + Nuevo Curso
        </a>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">
            <h4>Cursos</h4>            
        </div>

        <div class="panel-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Duración (hrs)</th>
                        <th>Área temática</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.DuracionHoras</td>
                                <td>
                                    @(item.AreaTematica != null
                                    ? item.AreaTematica.Clave + " - " + item.AreaTematica.Nombre
                                    : "N/A")
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-primary btn-xs">
                                        Editar
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-xs">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                No hay cursos registrados
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>