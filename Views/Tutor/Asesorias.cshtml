@model List<TAS360.Models.ViewModel.TutorEstudianteViewModel>
    @{
        ViewBag.Title = "Asesorias";
    }

<div class="jumbotron">
    <h1 class="display-4">Asesorias</h1>
    <p class="lead">Lista de asignaciones de tutores a estudiantes.</p>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">Listado de Tutores</h3>
        <div class="input-group pull-right" style="width: 300px;">
            @using (Html.BeginForm("Asesorias", "Tutor", FormMethod.Get))
            {
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Búsqueda de Asesorias..." value="@Request.QueryString["searchString"]" />
                    <span class="input-group-btn">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </span>
                </div>
            }
        </div>
    </div>

    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    @*<th>Tutor</th>*@
                    <th>Tutor</th>
                    @*<th>Estudiante</th>*@
                    <th>Estudiantes</th>
                    <th>Fecha Registro</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        @*<td>@item.Tutor</td>*@
                        <td>@item.N_Tutor</td>
                        @*<td>@item.Estudiante</td>*@
                        <td>@item.N_Estudiante</td>
                        <td>@item.fechaHora</td>
                        <td>
                            <a href="@Url.Action("EditAsesorias", "Tutor", new { id = item.Id })" class="btn btn-primary btn-sm">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </a>
                            <a style="margin: 3px 0px 0px 0px" href="@Url.Action("DeleteAsesoria", "Tutor", new { id = item.Id })" class="btn btn-danger btn-sm"
                               onclick="return confirm('¿Estás seguro de eliminar esta Asesorias?');">
                                <i class="glyphicon glyphicon-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
