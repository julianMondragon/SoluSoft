@model List<TAS360.Models.ViewModel.TutorEstudianteViewModel>
    @{
        ViewBag.Title = "Asesorias";
        Layout = "~/Views/Shared/_Layout3.cshtml";
    }

<div class="jumbotron">
    <h1 class="display-4">Asignaciones de Tutores</h1>
    <p class="lead">Lista de estudiantes asignados a tutores.</p>
</div>

    <div class="panel panel-default">
        <div class="panel-heading">
            <h3 class="panel-title">Listado</h3>
        </div>

        <div class="panel-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        @*<th>Tutor</th>*@
                        <th>Tutor</th>
                        @*<th>Estudiante</th>*@
                        <th>Estudiantes</th>
                        <th>Fecha Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            @*<td>@item.Tutor</td>*@
                            <td>@item.N_Tutor</td>
                            @*<td>@item.Estudiante</td>*@
                            <td>@item.N_Estudiante</td>
                            <td>@item.fechaHora</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
