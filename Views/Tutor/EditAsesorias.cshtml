@model TAS360.Models.ViewModel.TutorEstudianteViewModel
@{
    ViewBag.Title = "Editar Asesoría";
}

<div class="jumbotron">
    <h1 class="display-4">Editar Asesoría</h1>
    <p class="lead">Modificar la relación entre Tutor y Estudiante.</p>
</div>

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-primary">
            <div class="panel-heading">
                <h3 class="panel-title">
                    <i class="glyphicon glyphicon-education"></i> Formulario de Edición
                </h3>
            </div>
            <div class="panel-body">
                @using (Html.BeginForm("EditAsesorias", "Tutor", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @Html.HiddenFor(m => m.Id)
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Tutor, "Tutor", new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.Tutor, (SelectList)ViewBag.Tutores, "Seleccione un tutor", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Tutor, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Estudiante, "Estudiante", new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.Estudiante, (SelectList)ViewBag.Estudiantes, "Seleccione un estudiante", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Estudiante, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.fechaHora, "Fecha", new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.fechaHora, "{0:yyyy-MM-dd HH:mm}", new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.fechaHora, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-4 col-md-8">
                            <button type="submit" class="btn btn-success">Guardar cambios</button>
                            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default" })
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
