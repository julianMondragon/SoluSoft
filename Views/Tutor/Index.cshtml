@model List<TAS360.Models.ViewModel.HikvisionTutorViewModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}

<div class="jumbotron">
    <h1 class="display-4">Tutores</h1>
    <p class="lead">Lista de Tutores registrados.</p>
    <p>
        <a href="@Url.Action("Create", "Tutor")" class="btn btn-success">Agregar Tutor »</a>
    </p>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">Listado de Estudiantes</h3>
    </div>

    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Telefono</th>
                    <th>ID Externo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Correo</td>
                        @*<td>@item.TelefonoPersonal</td>*@
                        <td>@item.Telefono</td>
                        <td>@item.IdExterno</td>
                        <td>
                            <a href="@Url.Action("Edit", "Tutor", new { id = item.id })" class="btn btn-primary btn-sm">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </a>
                            <br>
                            <a style="margin: 3px 0px 0px 0px" href="@Url.Action("Delete", "Estudiantes", new { id = item.id })" class="btn btn-danger btn-sm"
                               onclick="return confirm('¿Estás seguro de eliminar este estudiante?');">
                                <i class="glyphicon glyphicon-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

