@model List<TAS360.Models.ViewModel.TicketViewModel>
@{
    ViewBag.Title = "ReportHis";

    var fechaActual = DateTime.Today;
    var anioInicio = 2025;
    var anioFin = fechaActual.Year;
    var fechasDisponibles = (HashSet<string>)ViewBag.FechasDisponibles;
}

<div class="jumbotron">
    <h1>Reportes Históricos</h1>
</div>

@for (int anio = anioInicio; anio <= anioFin; anio++)
{
    <h3>@anio</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mes</th>
                <th>1° Reportes</th>
                <th>15° Reportes</th>
            </tr>
        </thead>
        <tbody>
            @{
                int mesLimite = (anio == fechaActual.Year) ? fechaActual.Month : 12;
            }

            @for (int mes = 1; mes <= mesLimite; mes++)
            {
                var fechaUno = new DateTime(anio, mes, 1);
                var fechaQuince = new DateTime(anio, mes, 15);
                var nombreArchivoUno = fechaUno.ToString("ddMMyy");
                var nombreArchivoQuince = fechaQuince.ToString("ddMMyy");
                <tr>
                    <td>@fechaUno.ToString("MMMM")</td>
                    <td>
                        @if (fechaUno <= fechaActual)
                        {
                            if (fechasDisponibles.Contains(nombreArchivoUno))
                            {
                                <a class="btn btn-primary" target="_blank"
                                   href="@Url.Action("VerReportePDF", "LSA", new { fecha = fechaUno.ToString("yyyy-MM-dd") })">
                                    1° Reporte
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                    <td>
                        @if (fechaQuince <= fechaActual)
                        {
                            if (fechasDisponibles.Contains(nombreArchivoQuince))
                            {
                                <a class="btn btn-success" target="_blank"
                                   href="@Url.Action("VerReportePDF", "LSA", new { fecha = fechaQuince.ToString("yyyy-MM-dd") })">
                                    15° Reporte
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">No disponible</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
