@model List<TAS360.Models.ViewModel.TicketViewModel>
@{
    ViewBag.Title = "ReportHis";

    var fechaActual = DateTime.Today;
    var anioInicio = 2025;
    var anioFin = fechaActual.Year;
}

<div class="jumbotron">
    <h1>Reportes Históricos</h1>
</div>

@for (int anio = anioInicio; anio <= anioFin; anio++)
{
    <h3>@anio</h3>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mes</th>
                <th>1° Reportes</th>
                <th>15° Reportes</th>
            </tr>
        </thead>
        <tbody>
            @for (int mes = 1; mes <= 12; mes++)
            {
                var fechaUno = new DateTime(anio, mes, 1);
                var fechaQuince = new DateTime(anio, mes, 15);
                <tr>
                    <td>@fechaUno.ToString("MMMM")</td>
                    <td>
                        @if (fechaUno <= fechaActual)
                        {
                            <a href="@Url.Action("PrintSLAReportHis", "LSA", new { fecha = fechaUno.ToString("yyyy-MM-dd") })" class="btn btn-primary">
                                1° Reporte
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                    <td>
                        @if (fechaQuince <= fechaActual)
                        {
                            <a href="@Url.Action("PrintSLAReportHis", "LSA", new { fecha = fechaQuince.ToString("yyyy-MM-dd") })" class="btn btn-success">
                                15° Reporte
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">No disponible</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
