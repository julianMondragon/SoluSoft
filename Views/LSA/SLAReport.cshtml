    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        document.getElementById("btnGenerarPDF").addEventListener("click", function () {
            console.log("Botón presionado");

            const container = document.querySelector("#slaReportContainer");
            if (!container) {
                console.error("No se encontró el contenedor.");
                return;
            }

            html2canvas(container, { scale: 1.5 }).then(canvas => {
                console.log("Canvas generado");

                const imgData = canvas.toDataURL("image/png");
                const pdf = new jspdf.jsPDF('p', 'mm', 'a4');
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = pdf.internal.pageSize.getHeight();

                const margin = 10;
                const imgWidth = pdfWidth - 2 * margin;
                const imgHeight = canvas.height * imgWidth / canvas.width;

                let heightLeft = imgHeight;
                let position = margin;

                pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight);
                heightLeft -= pdfHeight;

                while (heightLeft > 0) {
                    position = heightLeft - imgHeight + margin;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', margin, position, imgWidth, imgHeight);
                    heightLeft -= pdfHeight;
                }

                const fecha = new Date();
                const dd = String(fecha.getDate()).padStart(2, '0');
                const mm = String(fecha.getMonth() + 1).padStart(2, '0'); // Enero es 0
                const yy = String(fecha.getFullYear()).slice(-2);
                /*const nombreArchivo = `${yyyy}_${mm}_${dd}.pdf`;*/
                const nombreArchivo = `${dd}${mm}${yy}.pdf`;
                pdf.save(nombreArchivo);
                pdf.output('blob').then(blob => {
                    const form = new FormData();
                    form.append('file', blob, nombreArchivo);

                    fetch('/LSA/GuardarPDF', {
                        method: 'POST',
                        body: form
                    })
                        .then(async response => {
                            console.log("Respuesta recibida, status:", response.status);
                            if (!response.ok) {
                                const errorText = await response.text();
                                throw new Error("Error del servidor: " + errorText);
                            } else {
                                alert("El PDF se guardó correctamente en el servidor.");
                            }
                        })
                        .catch(error => {
                            console.error("Error en fetch:", error);
                            alert("Ocurrió un error: " + error.message);
                        });
                });

            }).catch(err => {
                console.error("Error al generar canvas:", err);
            });
        });


    </script>
}
