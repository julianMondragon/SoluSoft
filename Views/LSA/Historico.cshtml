@model List<TAS360.Models.ViewModel.ReporteModel>

<h2>Reporte desde @Model.FirstOrDefault()?.Fecha.ToString("yyyy-MM-dd") hasta @Model.LastOrDefault()?.Fecha.ToString("yyyy-MM-dd")</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Descripción</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reporte in Model)
        {
            <tr>
                <td>@reporte.Fecha.ToString("yyyy-MM-dd")</td>
                <td>@reporte.Descripcion</td>
                <td>@reporte.Estado</td>
            </tr>
        }
    </tbody>
</table>

