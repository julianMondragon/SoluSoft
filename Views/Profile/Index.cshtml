
@model TAS360.Models.ViewModel.PerfilusrViewModel
@{
    ViewBag.Title = "Perfil del usuario";
}

<div class="jumbotron text-left">
    <h1>Mi Perfil</h1>
</div>

<div class="row">
    <div class="col-md-3 text-center">
        <div class="profile-photo-container">
            @if (Model.Foto_usuario != null && Model.Foto_usuario.Length > 0) // Validar que la imagen no sea nula
            {
                string base64String = Convert.ToBase64String(Model.Foto_usuario);
                string imageDataURL = $"data:image/png;base64,{base64String}"; // Asegúrate de usar el tipo de imagen correcto
                <img src="@imageDataURL" alt="Foto de perfil" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
            }
            else
            {
                <img src="~/images/default-user.png" alt="Foto de perfil" class="img-thumbnail" style="max-width: 200px; max-height: 200px;" />
            }
        </div>
        <button type="submit" class="btn btn-primary">Editar Imagen &raquo;</button>
    </div>

    <!-- Sección para la información del perfil del usuario -->
    <div class="col-md-9">
        <div class="card">
            <div class="card-header bg-success text-white">
                Información del Perfil
            </div>
            <div class="card-body">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td class="font-weight-bold">ID:</td>
                            <td>@Model.id_User</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Nombre:</td>
                            <td>@Model.nombre</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Email:</td>
                            <td>@Model.email</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Teléfono Celular:</td>
                            <td>@Model.Cel</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Género:</td>
                            <td>@Model.Género</td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold">Estado:</td>
                            <td>@Model.Estado</td>
                        </tr>
                    </tbody>
                </table>

                <button onclick="document.location.href = '@Url.Content("~/Profile/EditProfile")'" type="button" class="btn btn-primary" data-toggle="tooltip" title="Editar perfil">
                    Editar perfil &raquo;
                </button>
                <button type="button" class="btn btn-warning" data-toggle="tooltip" title="Editar contraseña">
                    Editar contraseña &raquo;
                </button>
                <button type="button" class="btn btn-default" onclick="location.href='@Url.Action("Home", "Home")'">Regresar  &laquo;</button>
            </div>
        </div>
    </div>
</div>
