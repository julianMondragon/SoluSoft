@{
    ViewBag.Title = "Productos Control de Acceso";
}

<div class="container">
    
    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Equipos de Control de Acceso</h2>

        <p>
            Ofrecemos dispositivos modernos de control de acceso y registro
            de asistencia que permiten gestionar el ingreso del personal
            de forma segura, rápida y automatizada.
        </p>
    </div>
    <!-- TERMINAL FACIAL -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/hikvision-terminal2.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Terminal de reconocimiento facial</h3>

            <p class="lead">
                Dispositivo inteligente que permite registrar la asistencia
                del personal mediante reconocimiento facial o tarjeta RFID.
            </p>

            <p class="lead">
                Reconocimiento facial | Lectura de tarjetas | Control de acceso |
                Integración con software de asistencia | Gestión de usuarios.
            </p>

            <p>
                    <a href="@Url.Action("Index", "ContactoSSF", new {
                            servicio = "Control de Acceso",
                            origen = "Productos/CA",
                            mensaje = "Hola, necesito un equipo de control de acceso DS-K1T320 para mi negocio..."})"
                       class="btn btn-warning">Me interesa este equipo</a>
                <a onclick="document.location.href = '@Url.Content("~/Content/Documents/DS-K1T320MFWX-B.pdf")'" class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- LECTOR RFID -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/lector-rfid.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Lector de tarjetas RFID</h3>

            <p class="lead">
                Sistema de identificación mediante tarjetas que permite
                controlar el acceso de usuarios autorizados a áreas
                restringidas.
            </p>

            <p class="lead">
                Identificación rápida | Control de acceso | Compatible con
                sistemas de asistencia | Integración con torniquetes
                o puertas electrónicas.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Control de Acceso",
                        origen = "Productos/CA",
                        mensaje = "Hola, necesito un equipo de control de radio frecuencia RFDI para mi negocio..."})" class="btn btn-warning">Me interesa este equipo</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- TARJETAS RFID -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/tarjetas-rfid.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Tarjetas de proximidad RFID</h3>

            <p class="lead">
                Tarjetas de identificación utilizadas para autenticar
                usuarios dentro del sistema de control de acceso.
            </p>

            <p class="lead">
                Alta durabilidad | Lectura rápida | Compatibles con lectores
                RFID | Ideales para empleados y visitantes.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Control de Acceso",
                        origen = "Productos/CA",
                        mensaje = "Hola, necesito un tarjetas de radio frecuencia RFDI para mi negocio..."})" 
                   class="btn btn-warning ">Me interesa este equipo</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- SOFTWARE -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/software-asistencia.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Software de control de asistencia</h3>

            <p class="lead">
                Plataforma desarrollada para gestionar el registro de
                asistencia del personal mediante dispositivos de control
                de acceso.
            </p>

            <p class="lead">
                Gestión de empleados | Reportes de asistencia |
                Integración con dispositivos Hikvision |
                Monitoreo en tiempo real | Panel administrativo.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                            servicio = "Videovigilancia CCTV",
                            origen = "Productos/CCTV",
                            mensaje = "Hola, necesito un software de control de asistencia para mi negocio..."})"
                   class="btn btn-warning">Solicitar demostración</a>
                <a class="btn btn-success">Más información</a>
            </p>

        </div>

    </div>


</div>

