
@{
    ViewBag.Title = "Productos CCTV";
}

<div class="container">

    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Productos de Videovigilancia</h2>
        <p class="lead">
            Ofrecemos equipos de videovigilancia modernos diseñados para
            proteger hogares, negocios y oficinas. Nuestros sistemas
            combinan cámaras inteligentes, grabación segura y monitoreo
            remoto desde dispositivos móviles.
        </p>
    </div>


    <!-- CAMARA TAPO -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/camara-tapo.png" class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Cámara WiFi Tapo 2K</h3>

            <p class="lead">
                Cámara inteligente con visión panorámica diseñada para
                supervisar accesos, patios o interiores del hogar.
            </p>

            <p class="lead">
                Resolución 2K (4MP) | Visión nocturna Starlight |
                Detección de movimiento | Alertas en smartphone |
                Sirena y luz de alerta | Grabación en nube o microSD
            </p>

            <p class="lead">
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Videovigilancia CCTV",
                        origen = "Productos/CCTV",
                        mensaje = "Hola, necesito una Cámara WiFi Tapo 2K inteligente con visión panorámica diseñada para supervisar accesos, patios o interiores del hogar...."})"
                   class="btn btn-warning">Me interesa esta cámara</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- CAMARA HIKVISION -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/camara-hikvision.png" class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Cámara Domo Hikvision Antivandálica</h3>

            <p class="lead">
                Cámara profesional diseñada para instalaciones exteriores
                que requieren mayor resistencia y seguridad.
            </p>

            <p class="lead">
                Resolución 1080p | Conectividad WiFi | Protocolo ONVIF |
                Visión nocturna hasta 30 metros | Montaje en techo |
                Ideal para exteriores.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Videovigilancia CCTV",
                        origen = "Productos/CCTV",
                        mensaje = "Hola, necesito una Cámara Domo Hikvision Antivandálica profesional diseñada para instalaciones exteriores que requieren mayor resistencia y seguridad para mi negocio..."})"
                   class="btn btn-warning">Me interesa esta cámara</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- CAMARA DOBLE LENTE -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/camara-doble-lente.png" class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Cámara WiFi Doble Lente 4K</h3>

            <p class="lead">
                Sistema avanzado con doble lente que permite monitoreo
                panorámico y seguimiento automático de movimiento.
            </p>

            <p class="lead">
                Resolución 4K | Control PTZ | Seguimiento automático |
                Visión nocturna en color | Audio bidireccional |
                Compatible con Alexa | Almacenamiento en nube o SD.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Control de Acceso",
                        origen = "Productos/CA",
                        mensaje = "Hola, necesito un Cámara WiFi Doble Lente 4K con sistema avanzado con doble lente que permite monitoreo panorámico y seguimiento automático de movimiento para mi negocio..."})"
                   class="btn btn-warning">Me interesa esta cámara</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>

    <hr />


    <!-- CAMARA SOLAR -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/camara-solar.png" class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Cámara Solar Reobiux 2K</h3>

            <p class="lead">
                Cámara de seguridad autónoma con panel solar ideal
                para lugares donde no se dispone de cableado eléctrico.
            </p>

            <p class="lead">
                Resolución 2K | Visión nocturna | Doble lente |
                Audio bidireccional | Conectividad WiFi |
                Energía solar | Compatible con smartphone.
            </p>

            <p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Control de Acceso",
                        origen = "Productos/CA",
                        mensaje = "Hola, necesito un Cámara Solar Reobiux 2K de seguridad autónoma con panel solar ideal para lugares donde no se dispone de cableado eléctrico..."})"
                   class="btn btn-warning">Me interesa esta cámara</a>
                <a class="btn btn-success">Ficha técnica</a>
            </p>

        </div>

    </div>


</div>

