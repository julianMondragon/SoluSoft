
@{
    ViewBag.Title = "Soluciones de Consultoría TI";
}

<div class="container">

    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Soluciones Tecnológicas</h2>
        <p class="lead">
            En NEGMON ayudamos a las empresas a modernizar su infraestructura
            tecnológica mediante herramientas y plataformas que optimizan
            procesos, aumentan la productividad y fortalecen la seguridad
            de la información.
        </p>
    </div>


    <!-- AUTOMATIZACION -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/automatizacion.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Automatización de procesos</h3>

            <p class="lead">
                Implementamos soluciones de software que permiten automatizar
                tareas repetitivas y optimizar procesos operativos dentro
                de las organizaciones.
            </p>

            <p class="lead">
                Desarrollo de aplicaciones empresariales | Integración de sistemas |
                Automatización de flujos de trabajo | Optimización de procesos.
            </p>

            @*<p>
                <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Consultoría TI",
                        origen = "Quienes somos",
                        mensaje = "Hola, necesito Desarrollo de aplicaciones empresariales | Integración de sistemas |Automatización de flujos de trabajo | Optimización de procesos. mi negocio..."})"
                    class="btn btn-warning">Solicitar información</a>
            </p>*@

        </div>

    </div>

    <hr />


    <!-- DESARROLLO SOFTWARE -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/desarrollo-software.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Desarrollo de software empresarial</h3>

            <p class="lead">
                Diseñamos y desarrollamos aplicaciones a la medida
                que se adaptan a las necesidades específicas de cada
                empresa o proyecto.
            </p>

            <p class="lead">
                Sistemas web | APIs | Integración con hardware |
                Plataformas empresariales | Desarrollo en .NET.
            </p>

            @*<p>
                <a class="btn btn-warning">Solicitar información</a>
            </p>*@

        </div>

    </div>

    <hr />


    <!-- INTEGRACION -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/integracion-sistemas.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Integración de sistemas</h3>

            <p class="lead">
                Conectamos distintas plataformas tecnológicas para
                que trabajen de forma integrada y eficiente.
            </p>

            <p class="lead">
                Integración con dispositivos industriales |
                Sistemas de control | Bases de datos |
                Servicios web | Automatización industrial.
            </p>

            @*<p>
                <a class="btn btn-warning">Solicitar información</a>
            </p>*@

        </div>

    </div>

    <hr />


    <!-- INFRAESTRUCTURA -->
    <div class="row">

        <div class="col-md-3">
            <img src="~/Content/img/infraestructura-ti.png"
                 class="img-responsive">
        </div>

        <div class="col-md-9">

            <h3>Infraestructura TI</h3>

            <p class="lead">
                Diseñamos arquitecturas tecnológicas sólidas que
                permiten a las organizaciones operar con mayor
                estabilidad, seguridad y escalabilidad.
            </p>

            <p class="lead">
                Servidores | Redes empresariales | Seguridad |
                Virtualización | Infraestructura cloud.
            </p>

            @*<p>
                <a class="btn btn-warning">Solicitar información</a>
            </p>*@

        </div>

    </div>


    <hr />


    <div class="text-center">

        <h3>Impulsa la transformación digital de tu empresa</h3>

        <p class="lead">
            Nuestro equipo de especialistas puede ayudarte a diseñar
            e implementar soluciones tecnológicas alineadas con los
            objetivos de tu organización.
        </p>

        <p>
            <a href="@Url.Action("Index", "ContactoSSF", new {
                        servicio = "Consultoría TI",
                        origen = "Quienes somos",
                        mensaje = "Hola, necesito modernizar lu infraestructura tecnológica de mi negocio mediante herramientas y plataformas que optimizan procesos, aumentan la productividad y fortalecerán la seguridad de la información de mi negocio..."})"
                   class="btn btn-primary btn-lg">
                Hablar con un asesor »
            </a>
        </p>

    </div>

</div>

