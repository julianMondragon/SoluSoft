@model IList<TAS360.Models.ViewModel.Documentos.DocumentoListItemViewModel>
@{
    ViewBag.Title = "Documentos";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}

<div class="container">
    <div class="jumbotron">
        <h2>Documentos</h2>
        <p>Administración persistente de reportes, cotizaciones, requerimientos y documentos generales.</p>
        <a class="btn btn-success" href="@Url.Action("Create")"><span class="glyphicon glyphicon-plus"></span> Crear documento</a>
    </div>

    @if (TempData["InfoMessage"] != null) { <div class="alert alert-success">@TempData["InfoMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
    @if (ViewBag.ExceptionMessage != null) { <div class="alert alert-danger">@ViewBag.ExceptionMessage</div> }

    <div class="panel panel-default">
        <div class="panel-heading"><strong>Documentos activos (@Model.Count)</strong></div>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead><tr><th>Folio</th><th>Tipo</th><th>Título</th><th>Emisión</th><th>Estado</th><th>Acciones</th></tr></thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No hay documentos activos.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Folio</td>
                        <td>@item.TipoDocumento</td>
                        <td>@item.Titulo</td>
                        <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                        <td><span class="label label-@(item.Estado == "Cancelado" ? "danger" : item.Estado == "Generado" ? "success" : "warning")">@item.Estado</span></td>
                        <td>
                            <a class="btn btn-xs btn-info" href="@Url.Action("Details", new { id = item.Id })">Detalle</a>
                            <a class="btn btn-xs btn-primary" href="@Url.Action("Edit", new { id = item.Id })">Editar</a>
                            <a class="btn btn-xs btn-danger" href="@Url.Action("Delete", new { id = item.Id })">Eliminar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
