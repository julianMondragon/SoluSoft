@model TAS360.Models.ViewModel.Documentos.DocumentoIndexViewModel
@{
    ViewBag.Title = "Documentos";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}

<div class="jumbotron">
    <h1>Documentos</h1>
    <p class="lead">Gestión persistente de documentos activos (@Model.Documentos.Count)</p>
    @if (Model.CanCreate)
    {
        <a class="btn btn-success" href="@Url.Action("Create")">
            <span class="glyphicon glyphicon-plus"></span> Nuevo documento &raquo;
        </a>
    }
</div>

@if (TempData["InfoMessage"] != null) { <div class="alert alert-success">@TempData["InfoMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
@if (ViewBag.ExceptionMessage != null) { <div class="alert alert-danger">@ViewBag.ExceptionMessage</div> }

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <div class="pull-left"><strong>Documentos activos</strong></div>
    </div>
    <div class="panel-body">
        @using (Html.BeginForm("Index", "Documento", FormMethod.Get, new { @class = "form-horizontal", role = "search" }))
        {
            <div class="row">
                <div class="col-sm-2 form-group-sm"><label>Folio</label>@Html.TextBoxFor(m => m.Folio, new { @class = "form-control", placeholder = "REQ-001" })</div>
                <div class="col-sm-3 form-group-sm"><label>Título</label>@Html.TextBoxFor(m => m.Titulo, new { @class = "form-control", placeholder = "Título" })</div>
                <div class="col-sm-2 form-group-sm"><label>Cliente</label>@Html.TextBoxFor(m => m.Cliente, new { @class = "form-control", placeholder = "Cliente" })</div>
                <div class="col-sm-2 form-group-sm"><label>Tipo</label>@Html.DropDownListFor(m => m.TipoDocumento, Model.TiposDocumento, "Todos", new { @class = "form-control" })</div>
                <div class="col-sm-2 form-group-sm"><label>Estado</label>@Html.DropDownListFor(m => m.Estado, Model.EstadosDocumento, "Todos", new { @class = "form-control" })</div>
                <div class="col-sm-1" style="padding-top:20px"><button type="submit" class="btn btn-primary">Buscar</button></div>
            </div>
            <div class="text-right" style="margin-top:8px"><a href="@Url.Action("Index")">Limpiar filtros</a></div>
        }
    </div>

    <div class="table-responsive">
        <table id="DocumentTable" class="table table-success table-striped table-hover">
            <thead>
                <tr><th>Folio</th><th>Tipo</th><th>Título</th><th>Cliente</th><th>Emisión</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
            @if (!Model.Documentos.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">No se encontraron documentos activos.</td></tr>
            }
            @foreach (var item in Model.Documentos)
            {
                <tr>
                    <td>@item.Folio</td>
                    <td>@item.TipoDocumento</td>
                    <td>@item.Titulo</td>
                    <td>@item.Cliente</td>
                    <td>@(item.FechaEmision == DateTime.MinValue ? "" : item.FechaEmision.ToString("dd/MM/yyyy"))</td>
                    <td><span class="label label-@(item.Estado == "Cancelado" ? "danger" : item.Estado == "Generado" ? "success" : "warning")">@item.Estado</span></td>
                    <td>
                        <a class="btn btn-xs btn-info" href="@Url.Action("Details", new { id = item.Id })" title="Consultar documento">
                            <span class="glyphicon glyphicon-eye-open"></span> Detalle
                        </a>
                        @if (Model.CanEdit)
                        {
                            <a class="btn btn-xs btn-primary" href="@Url.Action("Edit", new { id = item.Id })" title="Editar documento">
                                <span class="glyphicon glyphicon-pencil"></span> Editar
                            </a>
                        }
                        @if (Model.CanDelete)
                        {
                            <a class="btn btn-xs btn-danger" href="@Url.Action("Delete", new { id = item.Id })" title="Eliminar lógicamente">
                                <span class="glyphicon glyphicon-trash"></span> Eliminar
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
