@model IEnumerable<TAS360.Models.ViewModel.PlantelViewModel>
@{
    ViewBag.Title = "Planteles";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}

<div class="jumbotron">
    <h1 class="display-4">Planteles</h1>
    <p class="lead">Número de planteles registrados: @Model.Count()</p>
    <p>
        <a href="@Url.Action("Create", "Plantel")" class="btn btn-success">Nuevo Plantel »</a>
    </p>
</div>

<div class="panel panel-default">
    <div class="panel-heading clearfix">
        <h3 class="panel-title pull-left" style="padding-top: 7.5px;">Listado de Planteles</h3>
        <div class="input-group pull-right" style="width: 300px;">
            @using (Html.BeginForm("Index", "Plantel", FormMethod.Get))
            {
                <div class="input-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Búsqueda de plantel..." value="@Request.QueryString["searchString"]" />
                    <span class="input-group-btn">
                        <button class="btn btn-primary" type="submit">Buscar</button>
                    </span>
                </div>
            }
        </div>
    </div>

    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Administrador</th>
                    <th>Director</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Telefono</td>
                        <td>@item.Administrador</td>
                        <td>@item.Director</td>
                        <td>
                            <a href="@Url.Action("Edit", "Plantel", new { id = item.Id })" class="btn btn-primary btn-sm">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", "Plantel", new { id = item.Id })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de eliminar este plantel?');">
                                <i class="glyphicon glyphicon-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

