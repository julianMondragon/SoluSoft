@model TAS360.Models.ViewModel.ManageDC3.DC3ViewModel
@{
    ViewBag.Title = "Detalle DC3";
    Layout = "~/Views/Shared/_Layout3.cshtml";
}
<div class="container">
    <div class="jumbotron">
        <div class="col-md-2">
            <img src="~/Content/img/Negmon-logo.jpeg" style="max-height:120px;" />
        </div>
        <h2>Folio: @Model.Folio </h2>
        <p>
            Estatus: @Model.Status
        </p>       
    </div>
    <div class="panel panel-default" style="max-width:900px;margin:20px auto;">
        <div class="panel-heading text-center"><h3>CONSTANCIA DC-3</h3></div>
        <div class="panel-body">
            <p><strong>Folio:</strong> @Model.Folio</p>
            <p><strong>Empresa:</strong> @Model.EmpresaNombre</p>
            <p><strong>Trabajador:</strong> @Model.TrabajadorNombre</p>
            <p><strong>Curso:</strong> @Model.CursoNombre</p>
            <p><strong>Capacitador:</strong> @Model.CapacitadorNombre </p>
            <p><strong>Capacitador STPS:</strong> <strong>@Model.CapacitadorSTPS</strong> </p>
            <p><strong>Periodo:</strong> @Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")</p>
            <p><strong>Duracion:</strong> @Model.DuracionHoras horas</p>
            <p><strong>Puesto:</strong> @Model.Puesto</p>
            <p><strong>Ocupacion:</strong> @Model.OcupacionId</p>

            <div class="row" style="margin-top:30px;">
                <div class="col-md-4 text-center">
                    <strong>Firma Capacitador</strong><br />
                    @if (!string.IsNullOrEmpty(Model.RutaFirmaCapacitador))
                    {<img src="@Url.Content(Model.RutaFirmaCapacitador)" style="max-height:100px;" />}
                </div>
                <div class="col-md-4 text-center">
                    <strong>Firma Representante</strong><br />
                    @if (!string.IsNullOrEmpty(Model.RutaFirmaRepresentante))
                    {<img src="@Url.Content(Model.RutaFirmaRepresentante)" style="max-height:100px;" />}
                </div>
                <div class="col-md-4 text-center">
                    <strong>Firma Trabajador</strong><br />
                    @if (!string.IsNullOrEmpty(Model.RutaFirmaTrabajador))
                    {<img src="@Url.Content(Model.RutaFirmaTrabajador)" style="max-height:100px;" />}
                </div>
            </div>

            <div class="text-center" style="margin-top:20px;">
                @if (!string.IsNullOrEmpty(Model.QRUrl))
                {
                    <img src="@Url.Content(Model.QRUrl)" style="max-height:150px;" />
                }
            </div>
        </div>
        <div class="panel-footer text-right">
            @if (Model.Status == "Borrador")
            {
                @*<a class="btn btn-info" href="@Url.Action("Details", new { id = Model.Id })">Detalle</a>*@
                <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.Id })">Editar</a>
                <a class="btn btn-warning" href="@Url.Action("Firmar", new { id = Model.Id })">Firmar</a>


            }
            @if (Model.Status == "Firmado")
            {
                <a class="btn btn-info" href="@Url.Action("Details", new { id = Model.Id })">Detalle</a>
                <a class="btn btn-default" href="@Url.Action("GenerarQR", new { id = Model.Id })">Generar PDF</a>
                @*<a class="btn btn-xs btn-info" href="@Url.Action("DownloadQRDC3", new { path = item.QRUrl , FileName = item.Folio})">QR</a>*@


            }
            @if (Model.Status == "Generado")
            {
                @*<a class="btn btn-success" href="@Url.Action("DC3Report", new { id = Model.Id , userId = Model.CertificadorId })">PDF</a>*@
                <a class="btn btn-success" href="@Url.Action("DownloadFileDC3", new { path = Model.PdfUrl , FileName = Model.Folio})">Descargar</a>
                using (Html.BeginForm("DeleteConfirmed", "DC3", new { id = Model.Id }, FormMethod.Post, new { style = "display:inline-block" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" onclick="return confirm('¿Eliminar lógicamente este certificado?');">Eliminar</button>
                }

            }

            <a class="btn btn-default" href="@Url.Action("Index")">Volver</a>
        </div>
    </div>
</div>
