@model List<TAS360.Models.ViewModel.ManageDC3.DC3ViewModel>
@{
    ViewBag.Title = "Certificados DC-3";
    Layout = "~/Views/Shared/_Layout3.cshtml";
    string exception = ViewBag.ExceptionMessage;
}
<div class="container">
    <div class="jumbotron">
        <h2>Mis Certificados DC-3</h2>
        <p>Gestion completa de constancias STPS.</p>
        <a class="btn btn-success" href="@Url.Action("Create")">+ Crear certificado</a>
        @if (exception != null)
        {
            <div class="alert alert-danger" role="alert">
                @exception
            </div>
        }
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><strong>Listado (@Model.Count)</strong></div>
        <div class="panel-body table-responsive">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Trabajador</th>
                        <th>Empresa</th>
                        <th>Curso</th>
                        <th>Fechas</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Folio</td>
                            <td>@item.TrabajadorNombre</td>
                            <td>@item.EmpresaNombre</td>
                            <td>@item.CursoNombre</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy") - @item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a class="btn btn-xs btn-info" href="@Url.Action("Details", new { id = item.Id })">Detalle</a>
                                <a class="btn btn-xs btn-primary" href="@Url.Action("Edit", new { id = item.Id })">Editar</a>
                                <a class="btn btn-xs btn-warning" href="@Url.Action("Firmar", new { id = item.Id })">Firmar</a>
                                <a class="btn btn-xs btn-default" href="@Url.Action("GenerarQR", new { id = item.Id })">QR</a>
                                <a class="btn btn-xs btn-success" href="@Url.Action("DC3Report", new { id = item.Id , userId = item.CertificadorId })">PDF</a>
                                <a class="btn btn-xs btn-success" href="@Url.Action("PrintDC3", new { id = item.Id , userId = item.CertificadorId })">Descargar</a>
                                @using (Html.BeginForm("DeleteConfirmed", "DC3", new { id = item.Id }, FormMethod.Post, new { style = "display:inline-block" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" onclick="return confirm('¿Eliminar lógicamente este certificado?');">Eliminar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
