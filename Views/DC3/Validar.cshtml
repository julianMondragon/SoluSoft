@model TAS360.Models.ViewModel.ManageDC3.DC3ViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Validación de certificado DC-3</title>
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
</head>
<body>
    <div class="container" style="margin-top:30px;max-width:900px;">
        <div class="alert alert-success text-center"><strong>Certificado válido</strong></div>
        <table class="table table-bordered">
            <tr><th>Folio</th><td>@Model.Folio</td></tr>
            <tr><th>Empresa</th><td>@Model.EmpresaNombre</td></tr>
            <tr><th>Trabajador</th><td>@Model.TrabajadorNombre</td></tr>
            <tr><th>Curso</th><td>@Model.CursoNombre</td></tr>
            <tr><th>Periodo</th><td>@Model.FechaInicio.ToString("dd/MM/yyyy") - @Model.FechaFin.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>Duración</th><td>@Model.DuracionHoras horas</td></tr>
            <tr><th>Puesto</th><td>@Model.Puesto</td></tr>
            <tr><th>Ocupación</th><td>@Model.Ocupacion</td></tr>
        </table>
    </div>
</body>
</html>
