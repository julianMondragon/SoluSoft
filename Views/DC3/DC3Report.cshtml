@model TAS360.Models.ViewModel.ManageDC3.DC3ViewModel
@{
    Layout = null;
}


    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />
        <title>DC-3 Reporte</title>
        <style>
            page {
                page: A4;
                width: 210mm;
                min-height: 297mm;
                padding: 10mm;
                box-sizing: border-box;
                margin: 10mm;
            }

            body {
                width: 210mm;
                height: 297mm;
                margin: auto;
                background: white;
                font-family: Arial;
                font-size: 12px;
                margin: 20px;
                color: #000;
            }

            .title {
                text-align: center;
                font-weight: bold;
                margin-bottom: 10px;
                line-height: 1.2;
                text-transform: uppercase;
            }

                .title .line-1 {
                    font-size: 33px;
                    letter-spacing: 1px;
                }

                .title .line-2 {
                    font-size: 27px;
                }

            .section-title {
                background-color: black;
                color: white;
                padding: 5px;
                font-weight: bold;
                text-align: center;
                text-transform: uppercase;
                margin-top: 8px;
            }

            .table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin-bottom: 6px;
            }

                .table td {
                    border: 1px solid black;
                    padding: 4px;
                    vertical-align: top;
                }

            .label {
                font-size: 11px;
                margin-bottom: 2px;
            }

            .value {
                font-size: 12px;
                min-height: 14px;
                text-transform: uppercase;
            }

            .box {
                width: 20px;
                text-align: center;
                border: 1px solid black;
                padding: 1px 0;
                font-size: 12px;
            }

            .boxes {
                border-collapse: collapse;
                margin-top: 2px;
            }

                .boxes td {
                    border: 1px solid black;
                    width: 20px;
                    height: 20px;
                    text-align: center;
                    padding: 0;
                    vertical-align: middle;
                }

            .legal-text {
                text-align: center;
                font-weight: bold;
                padding: 10px 30px;
                line-height: 1.45;
            }

            .signatures td {
                text-align: center;
                vertical-align: bottom;
                width: 33.33%;
                padding: 8px 8px 4px;
            }

            .signature-role {
                margin-bottom: 6px;
            }

            .signature-image {
                height: 58px;
                max-width: 200px;
                object-fit: contain;
            }

            .signature-line {
                border: none;
                border-top: 1px solid black;
                margin: 4px 8px 2px;
            }

            .small-text {
                font-size: 10px;
                text-align: justify;
                line-height: 1.25;
            }

            .instructions-title {
                font-weight: bold;
                text-transform: uppercase;
                margin-top: 8px;
                margin-bottom: 3px;
            }

            .footer {
                text-align: right;
                margin-top: 16px;
                font-size: 20px;
                line-height: 1.1;
            }

        </style>
    </head>
    <body>
        <div class="page">
            <div class="title">
                <div class="line-1">FORMATO DC-3</div>
                <div class="line-2">CONSTANCIA DE COMPETENCIAS O DE HABILIDADES LABORALES</div>
            </div>

            <div class="section-title">DATOS DEL TRABAJADOR</div>
            <table class="table">
                <tr>
                    <td colspan="2">
                        <div class="label">Nombre (Anotar apellido paterno, apellido materno y nombre(s))</div>
                        <div class="value">@Model.TrabajadorNombre</div>
                    </td>
                </tr>
                <tr>
                    <td style="width:58%;">
                        <div class="label">Clave Única de Registro de Población</div>
                        <table>
                            <tr>
                                @foreach (var c in Model.CURPArray)
                                {
                                    <td class="box">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                    <td style="width:42%;">
                        <div class="label">Ocupación específica (Catálogo Nacional de Ocupaciones)</div>
                        <div class="value">@Model.OcupacionNombre</div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <div class="label">Puesto*</div>
                        <div class="value">@Model.Puesto</div>
                    </td>
                </tr>
            </table>

            <div class="section-title">DATOS DE LA EMPRESA</div>
            <table class="table">
                <tr>
                    <td>
                        <div class="label">Nombre o razón social</div>
                        <div class="value">@Model.EmpresaNombre</div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="label">Registro Federal de Contribuyentes con homoclave (SHCP)</div>
                        <table>
                            <tr>
                                @foreach (var c in Model.RFCArray)
                                {
                                    <td class="box">@c</td>
                                }
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <div class="section-title">DATOS DEL PROGRAMA DE CAPACITACIÓN, ADIESTRAMIENTO Y PRODUCTIVIDAD</div>
            <table class="table">
                <tr>
                    <td colspan="8">
                        <div class="label">Nombre del curso</div>
                        <div class="value">@Model.CursoNombre</div>
                    </td>
                </tr>
                <tr>
                    <td colspan="1">
                        <div class="label">Duración en horas</div>
                        <div class="value">@Model.DuracionHoras</div>
                    </td>
                    <td colspan="7">
                        <div class="label">Periodo de ejecución</div>
                        <table class="table" style="margin:0;">
                            <tr>
                                <td style="border:none; width:40px; text-align:center;">De</td>
                                <!-- Fecha Inicio -->
                                @foreach (var c in Model.FechaInicioArray[0])
                                {
                                    <td class="box">@c</td>
                                }
                                <td style="border:none; width:10px; text-align:center;">-</td>
                                @foreach (var c in Model.FechaInicioArray[1])
                                {
                                    <td class="box">@c</td>
                                }
                                <td style="border:none; width:10px; text-align:center;">-</td>
                                @foreach (var c in Model.FechaInicioArray[2])
                                {
                                    <td class="box">@c</td>
                                }
                                <td style="border:none; width:40px; text-align:center;">a</td>
                                <!-- Fecha Fin -->
                                @foreach (var c in Model.FechaInicioArray[0])
                                {
                                    <td class="box">@c</td>
                                }
                                <td style="border:none; width:10px; text-align:center;">-</td>
                                @foreach (var c in Model.FechaInicioArray[1])
                                {
                                    <td class="box">@c</td>
                                }
                                <td style="border:none; width:10px; text-align:center;">-</td>
                                @foreach (var c in Model.FechaInicioArray[2])
                                {
                                    <td class="box">@c</td>
                                }
                            </tr>
                            <tr>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="5">Año</td>
                                <td style="border:none;"></td>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="2">Mes</td>
                                <td style="border:none;"></td>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="2">Día</td>
                                <td style="border:none;"></td>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="4">Año</td>
                                <td style="border:none;"></td>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="2">Mes</td>
                                <td style="border:none;"></td>
                                <td style="border:none; text-align:center; font-size:10px;" colspan="2">Día</td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td colspan="8">
                        <div class="label">Área temática del curso</div>
                        <div class="value">@Model.CursoTematica</div>
                    </td>
                </tr>
                <tr>
                    <td colspan="8">
                        <div class="label">Nombre del agente capacitador y STPS:</div>
                        <div class="value">@Model.CapacitadorNombre</div>
                        <div class="value">@Model.CapacitadorSTPS</div>
                    </td>
                </tr>
            </table>

            <table class="table">
                <tr>
                    <td class="legal-text">
                        Los datos se asientan en esta constancia bajo protesta de decir verdad, apercibidos de la responsabilidad en que incurre todo aquel que no se conduce con verdad.
                    </td>
                </tr>
                <tr>
                    <td>
                        <table class="table signatures" style="border:none; margin:0;">
                            <tr>
                                <td style="border:none;" class="signature-role">Instructor o tutor</td>
                                <td style="border:none;" class="signature-role">Patrón o representante legal</td>
                                <td style="border:none;" class="signature-role">Representante de los trabajadores</td>
                            </tr>
                            <tr>
                                <td style="border:none;"><img class="signature-image" src="@Model.RutaFirmaCapacitador" alt="Firma instructor" /></td>
                                <td style="border:none;"><img class="signature-image" src="@Model.RutaFirmaRepresentante" alt="Firma representante legal" /></td>
                                <td style="border:none;"><img class="signature-image" src="@Model.RutaFirmaTrabajador" alt="Firma representante trabajadores" /></td>
                            </tr>
                            <tr>
                                <td style="border:none;"><hr class="signature-line" /><div class="value">@Model.CapacitadorNombre</div><div>Nombre y firma</div></td>
                                <td style="border:none;"><hr class="signature-line" /><div class="value">@Model.EmpresaNombre</div><div>Nombre y firma</div></td>
                                <td style="border:none;"><hr class="signature-line" /><div class="value">@Model.TrabajadorNombre</div><div>Nombre y firma</div></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <div class="instructions-title">INSTRUCCIONES</div>
            <div class="small-text">
                Llenar a máquina o con letra de molde. Deberá entregarse al trabajador dentro de los veinte días hábiles siguientes al término del curso de capacitación aprobado.
                Las áreas y subáreas ocupacionales del Catálogo Nacional de Ocupaciones se encuentran disponibles en el reverso de este formato.
                Los cursos impartidos por el área competente de la Secretaría del Trabajo y Previsión Social deberán cumplir con los lineamientos vigentes.
                Para empresas con menos de 51 trabajadores, para empresas con más de 50 trabajadores firmará el representante del patrón ante la Comisión Mixta de Capacitación, Adiestramiento y Productividad.
                Solo para empresas con más de 50 trabajadores. * Dato no obligatorio.
            </div>

            <div class="footer">
                DC-3<br />
                ANVERSO
            </div>
        </div>
    </body>
</html>
